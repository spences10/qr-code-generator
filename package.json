{
	"name": "qr-code-generator",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && vp check && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "vp check --fix",
		"lint": "vp check",
		"test:unit": "vp test",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-auto": "8.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "5.1.0",
		"daisyui": "5.5.19",
		"playwright": "1.65.0",
		"qr-code-styling": "^1.9.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.1.18",
		"typescript": "6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
		"vite-plus": "1.6.0",
		"vitest": "5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	}
}
